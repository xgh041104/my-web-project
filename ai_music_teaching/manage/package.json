{
  "name": "max",
  "version": "6.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src ",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx --format=pretty ./src",
    "lint:prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\" --end-of-line auto",
    "openapi": "max openapi",
    "prettier": "prettier -c --write \"**/**.{js,jsx,tsx,ts,less,md,json}\"",
    "preview": "npm run build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env PORT=8100 UMI_ENV=dev max dev",
    "start:dev": "cross-env PORT=8100 REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:no-mock": "cross-env PORT=8100 MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env PORT=8100 REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env PORT=8100 REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@alex_xu/react-slider-vertify": "^1.2.0",
    "@ant-design/icons": "^4.8.1",
    "@ant-design/plots": "^2.1.5",
    "@ant-design/pro-components": "^2.8.9",
    "@antv/l7": "^2.20.13",
    "@antv/l7-maps": "^2.20.13",
    "@antv/l7-react": "^2.4.3",
    "@umijs/route-utils": "^2.2.2",
    "abortcontroller-polyfill": "^1.7.8",
    "ace-builds": "^1.42.0",
    "antd": "^5.12.7",
    "antd-style": "^3.6.1",
    "axios": "^1.10.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.10",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "numeral": "^2.0.6",
    "omit.js": "^2.0.2",
    "path-to-regexp": "^6.2.1",
    "prop-types": "^15.8.1",
    "querystring": "^0.2.1",
    "quill-emoji": "^0.2.0",
    "quill-image-drop-module": "^1.0.3",
    "rc-util": "^5.38.1",
    "react": "^18.2.0",
    "react-ace": "^14.0.1",
    "react-dom": "^18.2.0",
    "react-fittext": "^1.0.0",
    "react-hls-player": "^3.0.7",
    "react-quill": "^2.0.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-unity-webgl": "^7.0.0",
    "sql.js": "1.12.0",
    "mammoth": "^1.12.0"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^2.1.5",
    "@testing-library/react": "^13.4.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/classnames": "^2.3.1",
    "@types/express": "^4.17.21",
    "@types/history": "^4.7.11",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.14.202",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "@types/react-helmet": "^6.1.11",
    "@umijs/fabric": "^2.14.1",
    "@umijs/lint": "^4.1.0",
    "@umijs/max": "^4.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "express": "^4.18.2",
    "gh-pages": "^3.2.3",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mockjs": "^1.1.0",
    "prettier": "^3.1.1",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-packagejson": "^2.4.8",
    "prettier-plugin-two-style-order": "^1.0.1",
    "react-dev-inspector": "^1.9.0",
    "swagger-ui-dist": "^4.19.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "umi-presets-pro": "^2.0.3"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}