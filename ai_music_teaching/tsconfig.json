{
    "compilerOptions": {
        "jsx": "react-jsx", 
        "baseUrl": "src",
        "paths": {
            "@/*": [
                "*"
            ]
        },
        "esModuleInterop": true,
        "moduleResolution": "node",
        "typeRoots": ["node_modules/@types", "src/types"]
    },
    "include": ["src/**/*", "src/types"]
}